{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "security-audit-orchestrator",
  "subagent_depth": 2,
  "permission": {
    "*": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "question": "deny",
    "doom_loop": "allow",
    "external_directory": "allow",
    "todowrite": "deny",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "deny"
    },
    "cpp_index_*": "deny",
    "jvm_index_*": "deny",
    "python_index_*": "deny",
    "audit_lab_*": "deny",
    "chrome-devtools_*": "deny",
    "windows-control_*": "deny"
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--isolated=true",
        "--redact-network-headers=true",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "cwd": ".",
      "timeout": 300000,
      "enabled": true
    },
    "cpp_index": {
      "enabled": false
    },
    "jvm_index": {
      "enabled": false
    },
    "python_index": {
      "enabled": false
    },
    "audit_lab": {
      "enabled": false
    },
    "windows-control": {
      "type": "local",
      "command": [
        "node",
        ".opencode/scripts/windows-control-mcp.mjs"
      ],
      "cwd": ".",
      "timeout": 30000,
      "enabled": false
    }
  },
  "plugin": [
    "./lib/audit-runtime/opencode-session-plugin.mjs"
  ]
}
