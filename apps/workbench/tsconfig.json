{
  "include": ["app/**/*", "shared/**/*", ".react-router/types/**/*", "vite.config.ts", "react-router.config.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "rootDirs": [".", "./.react-router/types"],
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "strict": true, "noEmit": true, "paths": { "@/*": ["./app/*"] }
  }
}
